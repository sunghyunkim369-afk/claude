# 필요한 환경변수 목록(견본)입니다. 실제 값은 여기에 쓰지 말고 아래 위치에 넣으세요.
#  - 서버 함수(api/)가 쓰는 값: Eyefeet Cloud 테넌트의 환경변수 설정
#  - 매일 데이터 생성(GitHub Actions)이 쓰는 값: GitHub 저장소 Settings → Secrets and variables → Actions
# 로컬에서 테스트할 때만 이 파일을 .env 로 복사해 값을 채우세요 (.env 는 커밋되지 않아요).

# Eyefeet AI (깃솔트 로컬 AI) · api/ai.js 가 사용
# 키 발급: eyefeetai.com 설정 → 계정 → API 키
AI_BASE_URL=https://www.eyefeetai.com/api/chat/completions
AI_API_KEY=
AI_MODEL=qwen3-30b-a3b
AI_API_STYLE=openai

# (선택) 외부 AI를 쓸 때 · Anthropic 콘솔에서 발급
ANTHROPIC_API_KEY=

# 뉴스 수집 (developers.naver.com 에서 발급)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 데이터베이스 (아직 사용하지 않음, 도입 시 사용)
DATABASE_URL=
