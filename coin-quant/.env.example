# coin-quant 비밀 값 (이 파일을 .env 로 복사해서 채우세요. .env 는 git 에 올라가지 않습니다)
# 키를 대화창·메신저·GitHub 에 절대 붙여넣지 마세요. 유출이 의심되면 업비트에서 즉시 삭제 후 재발급.
#
# 업비트 Open API 키 만들기 (업비트 웹 → 마이페이지 → Open API 관리)
#   - 권한: '자산조회', '주문조회', '주문하기'만 체크. '출금하기'는 절대 체크하지 마세요.
#   - 허용 IP: 이 프로그램을 돌리는 컴퓨터의 공인 IP 만 등록
#   - 추천 리포트만 쓸 때(stage 1)는 키가 없어도 됩니다.
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=

# 텔레그램 알림 (선택) — 휴대폰으로 매수·매도 알림 받기
#   1) 텔레그램에서 @BotFather → /newbot → 받은 토큰을 아래에
#   2) 만든 봇에게 아무 말이나 보낸 뒤 https://api.telegram.org/bot<토큰>/getUpdates 에서 "chat":{"id": 숫자} 를 아래에
#   3) python -m coinquant alert --test 로 확인
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
